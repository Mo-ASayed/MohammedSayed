# Contact form endpoint.
#
# Your email address must never appear in this repo or in the built HTML —
# that is the whole point of the form. The endpoint below belongs to a
# third-party service that holds your real address and filters spam.
#
# Setup with Formspree (free tier is enough):
#   1. Sign up at https://formspree.io and create a new form.
#   2. Point it at whichever inbox you want enquiries to land in.
#   3. Copy the endpoint it gives you and paste it below.
#   4. Add the same variable in Vercel: Project → Settings → Environment Variables.
#
# Leave it unset and the contact section falls back to a LinkedIn button.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
